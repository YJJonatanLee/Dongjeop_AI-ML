# ============================================
# Project Specific
# ============================================

# Model checkpoints (large files)
models/checkpoints/**/*.pth
models/checkpoints/**/*.pt
models/checkpoints/**/*.bin
models/checkpoints/**/*.safetensors

# Keep checkpoint directory structure but ignore model files
!models/checkpoints/.gitkeep
!models/checkpoints/*/.gitkeep

# Training outputs and logs
outputs/logs/**/*.log
outputs/logs/**/*.txt
outputs/predictions/**/*.csv
outputs/predictions/**/*.json

# Keep output directory structure
!outputs/.gitkeep
!outputs/logs/.gitkeep
!outputs/predictions/.gitkeep

# Temporary files
*.tmp
*.temp
/tmp/
temp/

# Downloaded images (temporary)
*.jpg.tmp
*.png.tmp
*.jpeg.tmp

# Data files (optional - uncomment if you want to exclude data)
